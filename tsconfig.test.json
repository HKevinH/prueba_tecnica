{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@backend/*": ["./src/backend/src/*"]
    }
  },
  "include": ["tests/**/*", "src/backend/src/**/*"]
}
